local function CreateSwitch(text, default)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 38)
    holder.BackgroundTransparency = 1
    holder.Parent = Content

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -65, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(225, 225, 230)
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(48, 24)
    button.Position = UDim2.new(1, -48, 0.5, -12)
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = holder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = button

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Position = UDim2.fromOffset(3, 3)
    knob.BorderSizePixel = 0
    knob.Parent = button

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local enabled = default == true

    local function update()

        if enabled then
            button.BackgroundColor3 = Color3.fromRGB(90, 150, 255)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.Position = UDim2.new(1, -21, 0, 3)
        else
            button.BackgroundColor3 = Color3.fromRGB(55, 57, 65)
            knob.BackgroundColor3 = Color3.fromRGB(160, 160, 170)
            knob.Position = UDim2.fromOffset(3, 3)
        end

    end

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        update()
    end)

    update()

    return {
        Get = function()
            return enabled
        end,

        Set = function(value)
            enabled = value == true
            update()
        end
    }
end

