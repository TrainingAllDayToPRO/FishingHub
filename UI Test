--==================================================
-- SWITCH
--==================================================

local function CreateSwitch(text, default)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 38)
    holder.BackgroundTransparency = 1
    holder.Parent = Content

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -65, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(225, 225, 230)
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(48, 24)
    button.Position = UDim2.new(1, -48, 0.5, -12)
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = holder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = button

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Position = UDim2.fromOffset(3, 3)
    knob.BorderSizePixel = 0
    knob.Parent = button

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local enabled = default or false

    local function update()
        if enabled then
            button.BackgroundColor3 = Color3.fromRGB(90, 150, 255)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.Position = UDim2.new(1, -21, 0, 3)
        else
            button.BackgroundColor3 = Color3.fromRGB(55, 57, 65)
            knob.BackgroundColor3 = Color3.fromRGB(160, 160, 170)
            knob.Position = UDim2.fromOffset(3, 3)
        end
    end

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        update()
    end)

    update()

    return {
        Get = function()
            return enabled
        end,
        Set = function(value)
            enabled = value
            update()
        end
    }
end


--==================================================
-- DROPDOWN
--==================================================

local openedDropdown = nil

local function CreateDropdown(text, options, default)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 38)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = false
    holder.Parent = Content

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.48, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(225, 225, 230)
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.fromOffset(145, 30)
    dropdown.Position = UDim2.new(1, -145, 0.5, -15)
    dropdown.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
    dropdown.BorderSizePixel = 0
    dropdown.Text = ""
    dropdown.AutoButtonColor = false
    dropdown.Parent = holder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = dropdown

    local selected = Instance.new("TextLabel")
    selected.Size = UDim2.new(1, -30, 1, 0)
    selected.Position = UDim2.fromOffset(10, 0)
    selected.BackgroundTransparency = 1
    selected.Text = default or options[1]
    selected.TextColor3 = Color3.fromRGB(235, 235, 240)
    selected.TextSize = 13
    selected.Font = Enum.Font.GothamMedium
    selected.TextXAlignment = Enum.TextXAlignment.Left
    selected.Parent = dropdown

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.fromOffset(25, 30)
    arrow.Position = UDim2.new(1, -27, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = Color3.fromRGB(160, 160, 170)
    arrow.TextSize = 10
    arrow.Font = Enum.Font.Gotham
    arrow.Parent = dropdown

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 0, #options * 30)
    list.Position = UDim2.new(0, 0, 1, 4)
    list.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
    list.BorderSizePixel = 0
    list.Visible = false
    list.ZIndex = 20
    list.Parent = dropdown

    local listCorner = Instance.new("UICorner")
    listCorner.CornerRadius = UDim.new(0, 7)
    listCorner.Parent = list

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = list

    local function close()
        list.Visible = false
        arrow.Text = "▼"

        if openedDropdown == list then
            openedDropdown = nil
        end
    end

    for _, option in ipairs(options) do
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, 0, 0, 30)
        item.BackgroundTransparency = 1
        item.Text = option
        item.TextColor3 = Color3.fromRGB(220, 220, 225)
        item.TextSize = 12
        item.Font = Enum.Font.Gotham
        item.ZIndex = 21
        item.Parent = list

        item.MouseButton1Click:Connect(function()
            selected.Text = option
            close()
        end)
    end

    dropdown.MouseButton1Click:Connect(function()
        if openedDropdown and openedDropdown ~= list then
            openedDropdown.Visible = false
        end

        list.Visible = not list.Visible

        if list.Visible then
            openedDropdown = list
            arrow.Text = "▲"
        else
            openedDropdown = nil
            arrow.Text = "▼"
        end
    end)

    return {
        Get = function()
            return selected.Text
        end,

        Set = function(value)
            if table.find(options, value) then
                selected.Text = value
            end
        end
    }
end


