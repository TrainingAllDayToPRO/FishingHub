local openedDropdown = nil

local function CreateDropdown(text, options, default)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 38)
    holder.BackgroundTransparency = 1
    holder.Parent = Content

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.45, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(225, 225, 230)
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.fromOffset(145, 30)
    dropdown.Position = UDim2.new(1, -145, 0.5, -15)
    dropdown.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
    dropdown.BorderSizePixel = 0
    dropdown.Text = ""
    dropdown.AutoButtonColor = false
    dropdown.ZIndex = 5
    dropdown.Parent = holder

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = dropdown

    local selected = Instance.new("TextLabel")
    selected.Size = UDim2.new(1, -30, 1, 0)
    selected.Position = UDim2.fromOffset(10, 0)
    selected.BackgroundTransparency = 1
    selected.Text = default or options[1]
    selected.TextColor3 = Color3.fromRGB(235, 235, 240)
    selected.TextSize = 13
    selected.Font = Enum.Font.GothamMedium
    selected.TextXAlignment = Enum.TextXAlignment.Left
    selected.ZIndex = 6
    selected.Parent = dropdown

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.fromOffset(25, 30)
    arrow.Position = UDim2.new(1, -27, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = Color3.fromRGB(160, 160, 170)
    arrow.TextSize = 10
    arrow.Font = Enum.Font.Gotham
    arrow.ZIndex = 6
    arrow.Parent = dropdown

    -- Dropdown list đặt trực tiếp trong Main
    local list = Instance.new("Frame")
    list.Size = UDim2.fromOffset(145, #options * 30)
    list.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
    list.BorderSizePixel = 0
    list.Visible = false
    list.ZIndex = 100
    list.Parent = Main

    local listCorner = Instance.new("UICorner")
    listCorner.CornerRadius = UDim.new(0, 7)
    listCorner.Parent = list

    local function updateListPosition()

        local absolute = dropdown.AbsolutePosition
        local mainAbsolute = Main.AbsolutePosition

        list.Position = UDim2.fromOffset(
            absolute.X - mainAbsolute.X,
            absolute.Y - mainAbsolute.Y + dropdown.AbsoluteSize.Y + 4
        )

    end

    local function close()

        list.Visible = false
        arrow.Text = "▼"

        if openedDropdown == list then
            openedDropdown = nil
        end

    end

    for _, option in ipairs(options) do

        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, 0, 0, 30)
        item.BackgroundTransparency = 1
        item.Text = option
        item.TextColor3 = Color3.fromRGB(220, 220, 225)
        item.TextSize = 12
        item.Font = Enum.Font.Gotham
        item.ZIndex = 101
        item.Parent = list

        item.MouseButton1Click:Connect(function()
            selected.Text = option
            close()
        end)

    end

    dropdown.MouseButton1Click:Connect(function()

        if openedDropdown and openedDropdown ~= list then
            openedDropdown.Visible = false
        end

        if list.Visible then
            close()
        else
            updateListPosition()
            list.Visible = true
            openedDropdown = list
            arrow.Text = "▲"
        end

    end)

    return {

        Get = function()
            return selected.Text
        end,

        Set = function(value)
            if table.find(options, value) then
                selected.Text = value
            end
        end

    }

end

